msgctxt "model:ir.message,text:msg_payment_different_process_method"
msgid ""
"Payment process method can not be mixed on payment groups. Payment process "
"\"%(process)s\" of line \"%(payment)s\" is diferent from previous payment "
"process \"%(pprocess)s\""
msgstr ""
"Fizetési csoporton belül nem keverhetők a feldolgozási módszerek. A(z) "
"„%(payment)s” sor „%(process)s” módszere eltér az előző „%(pprocess)s” "
"módszertől."

#, python-format
msgctxt "model:ir.message,text:msg_payment_non_posted_move"
msgid "You can not pay line \"%(line)s\" because its move \"%(move)s\" is not posted."
msgstr ""
"A(z) „%(line)s” sor nem fizethető ki, mert a(z) „%(move)s” könyvelési tétele"
" nincs feladva."

